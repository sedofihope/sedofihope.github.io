---
layout: null
---
{%- comment -%}
  Every page exists in both languages; each entry lists its alternates.
  The news archives are added once site.news_archive is enabled.
{%- endcomment -%}
{%- assign languages = site.data.content_en.languages -%}
{%- assign suffixes = "" | split: "," | push: "" -%}
{%- if site.news_archive -%}{%- assign suffixes = suffixes | push: "news/" -%}{%- endif -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for suffix in suffixes %}
{%- for l in languages %}
  <url>
    <loc>{{ l.url | append: suffix | absolute_url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
{%- for alt in languages %}
    <xhtml:link rel="alternate" hreflang="{{ alt.code }}" href="{{ alt.url | append: suffix | absolute_url }}"/>
{%- endfor %}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ '/' | append: suffix | absolute_url }}"/>
  </url>
{%- endfor %}
{%- endfor %}
</urlset>
