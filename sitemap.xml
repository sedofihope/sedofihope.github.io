---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- assign languages = site.data.content_en.languages %}
{%- for l in languages %}
  <url>
    <loc>{{ l.url | absolute_url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
{%- for alt in languages %}
    <xhtml:link rel="alternate" hreflang="{{ alt.code }}" href="{{ alt.url | absolute_url }}"/>
{%- endfor %}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ '/' | absolute_url }}"/>
  </url>
{%- endfor %}
</urlset>
